{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "title": "MathProblemPool",
    "description": "A pool of math problems",
    "type": "object",
    "required": ["problems"],
    "properties": {
        "problems": {
            "type": "array",
            "items": {
                "type": "object",
                "required": ["id", "domain", "skills", "difficulty", "curriculumStep", "prompt", "answer"],
                "properties": {
                    "id": { "type": "string", "minLength": 1 },
                    "domain": {
                        "type": "string",
                        "enum": ["addition", "subtraction", "multiplication", "division", "counting", "comparison", "pattern_matching", "number_sequence"]
                    },
                    "skills": { "type": "array", "items": { "type": "string" }, "minItems": 1 },
                    "difficulty": { "type": "number", "minimum": 1, "maximum": 5 },
                    "curriculumStep": { "type": "integer", "minimum": 0 },
                    "ageBand": {
                        "type": "array",
                        "items": { "type": "integer" },
                        "minItems": 2,
                        "maxItems": 2
                    },
                    "difficultyTraits": {
                        "type": "object",
                        "required": ["maxOperand"],
                        "properties": {
                            "maxOperand": { "type": "integer", "minimum": 0 },
                            "requiresCarry": { "type": "boolean" },
                            "requiresBorrow": { "type": "boolean" }
                        },
                        "additionalProperties": false
                    },
                    "prompt": {
                        "type": "object",
                        "required": ["text"],
                        "properties": {
                            "text": { "type": "string", "minLength": 1 },
                            "assets": { "type": ["string", "null"] }
                        }
                    },
                    "answer": {
                        "type": "object",
                        "required": ["mode", "correct"],
                        "properties": {
                            "mode": { "type": "string", "enum": ["mcq", "numeric_input", "sequence"] },
                            "correct": {},
                            "options": { "type": "array" },
                            "tolerance": { "type": "number" },
                            "distractors_rationale": { "type": "array", "items": { "type": "string" } }
                        }
                    },
                    "hint": { "type": "string" },
                    "explanation": { "type": "string" },
                    "misconceptionTags": { "type": "array", "items": { "type": "string" } },
                    "generator": {
                        "oneOf": [
                            { "type": "null" },
                            {
                                "type": "object",
                                "required": ["template", "params", "evaluator"],
                                "properties": {
                                    "template": { "type": "string" },
                                    "params": { "type": "object" },
                                    "evaluator": { "type": "string" }
                                }
                            }
                        ]
                    },
                    "phrasing": {
                        "description": "Localisable phrasing for prompt/hint/explanation. Purely additive: prompt.text, hint and explanation stay canonical English and remain what the arithmetic verifier, the replay key and the golden fixtures read. A renderer uses phrasing when the key resolves in the active locale and falls back to the English text otherwise, so a missing entry degrades to English rather than breaking. Derived and verified by tools/derive_math_phrasing.mjs against tools/math_phrasing_catalog.mjs.",
                        "type": "object",
                        "additionalProperties": false,
                        "properties": {
                            "prompt": { "$ref": "#/$defs/phrasingRef" },
                            "hint": { "$ref": "#/$defs/phrasingRef" },
                            "explanation": { "$ref": "#/$defs/phrasingRef" }
                        }
                    }
                }
            }
        }
    },
    "$defs": {
        "phrasingRef": {
            "type": "object",
            "required": ["key", "params"],
            "additionalProperties": false,
            "properties": {
                "plural": {
                    "description": "Name of the parameter that drives plural agreement, when the phrasing has one. The resolved category is deliberately NOT stored: each locale applies its own rule at render time, because they differ (English inflects at 1; Icelandic at 1, 21, 31, ...).",
                    "type": "string"
                },
                "key": {
                    "description": "A key in the i18n bundles, e.g. math.prompt.arith.what_is.",
                    "type": "string",
                    "pattern": "^math\\.(prompt|hint|expl)\\."
                },
                "params": {
                    "description": "Named substitutions. Values carry no natural language: numbers, the operator symbol, a glyph run, or a comma-joined number list. A `math.prompt.wrap.*` key takes an `inner` that is either a plain string with no words in it or a nested phrasing reference.",
                    "type": "object",
                    "additionalProperties": {
                        "oneOf": [
                            { "type": ["number", "string"] },
                            { "$ref": "#/$defs/phrasingRef" }
                        ]
                    }
                }
            }
        }
    }
}
