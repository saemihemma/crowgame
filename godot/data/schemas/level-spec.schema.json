{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "title": "LevelSpec",
    "description": "Agent-authored level specification for compilation",
    "type": "object",
    "required": [
        "id",
        "name",
        "theme",
        "difficulty",
        "platforms",
        "spawns",
        "exits"
    ],
    "properties": {
        "id": {
            "type": "string",
            "pattern": "^level_\\d+"
        },
        "name": {
            "type": "string",
            "minLength": 1
        },
        "theme": {
            "description": "World id. Selects the UI theme AND the tileset filename the level compiler emits (<theme>_tiles.png), so it must match a tileset key in godot/data/tilesets/tileset_manifest.json.",
            "type": "string",
            "enum": [
                "emberwood",
                "prism_hollow",
                "sugarstorm",
                "geyserworks",
                "aurora_spire"
            ]
        },
        "difficulty": {
            "type": "integer",
            "minimum": 1,
            "maximum": 10
        },
        "music": {
            "type": "string"
        },
        "criticalPath": {
            "type": "object",
            "required": [
                "length",
                "motifs"
            ],
            "properties": {
                "length": {
                    "type": "string",
                    "enum": [
                        "short",
                        "medium",
                        "long"
                    ]
                },
                "motifs": {
                    "type": "array",
                    "items": {
                        "type": "string"
                    }
                }
            }
        },
        "platforms": {
            "type": "array",
            "minItems": 1,
            "items": {
                "type": "object",
                "required": [
                    "type",
                    "x",
                    "width",
                    "y"
                ],
                "properties": {
                    "type": {
                        "type": "string",
                        "enum": [
                            "ground",
                            "platform"
                        ]
                    },
                    "x": {
                        "type": "number"
                    },
                    "width": {
                        "type": "number",
                        "minimum": 1
                    },
                    "y": {
                        "type": "number"
                    },
                    "gap_before": {
                        "type": "number",
                        "minimum": 0
                    }
                }
            }
        },
        "spawns": {
            "type": "object",
            "required": [
                "player"
            ],
            "properties": {
                "player": {
                    "type": "object",
                    "required": [
                        "x",
                        "y"
                    ],
                    "properties": {
                        "x": {
                            "type": "number"
                        },
                        "y": {
                            "type": "number"
                        }
                    }
                },
                "npcs": {
                    "type": "array",
                    "items": {
                        "type": "object",
                        "required": [
                            "npc_id",
                            "x",
                            "y"
                        ],
                        "properties": {
                            "npc_id": {
                                "type": "string"
                            },
                            "x": {
                                "type": "number"
                            },
                            "y": {
                                "type": "number"
                            }
                        }
                    }
                },
                "collectibles": {
                    "type": "array",
                    "items": {
                        "type": "object",
                        "required": [
                            "type",
                            "x",
                            "y"
                        ],
                        "properties": {
                            "type": {
                                "type": "string"
                            },
                            "x": {
                                "type": "number"
                            },
                            "y": {
                                "type": "number"
                            }
                        }
                    }
                }
            }
        },
        "exits": {
            "type": "array",
            "minItems": 1,
            "items": {
                "type": "object",
                "required": [
                    "x",
                    "y",
                    "target_level"
                ],
                "properties": {
                    "x": {
                        "type": "number"
                    },
                    "y": {
                        "type": "number"
                    },
                    "target_level": {
                        "type": "string"
                    }
                }
            }
        },
        "mathGating": {
            "type": "object",
            "properties": {
                "skills": {
                    "type": "array",
                    "items": {
                        "type": "string"
                    }
                },
                "difficultyBand": {
                    "type": "array",
                    "items": {
                        "type": "integer"
                    },
                    "minItems": 2,
                    "maxItems": 2
                },
                "teachingIntent": {
                    "type": "string",
                    "minLength": 1,
                    "description": "The lesson this level exists to teach, in one sentence. Required so every gating decision names its intent."
                }
            },
            "required": [
                "skills",
                "difficultyBand",
                "teachingIntent"
            ]
        }
    }
}
