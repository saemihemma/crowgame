{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "title": "NPCRegistry",
    "description": "Registry of all NPC definitions Sprite path and frame geometry live in sprite_registry.json, not here.",
    "type": "object",
    "required": [
        "npcs"
    ],
    "properties": {
        "npcs": {
            "type": "array",
            "items": {
                "type": "object",
                "required": [
                    "id",
                    "name",
                    "spriteKey",
                    "behavior",
                    "components",
                    "behaviorConfig"
                ],
                "properties": {
                    "id": {
                        "type": "string",
                        "minLength": 1
                    },
                    "name": {
                        "type": "string",
                        "minLength": 1
                    },
                    "spriteKey": {
                        "type": "string",
                        "minLength": 1,
                        "description": "Key into data/registries/sprite_registry.json, which owns the path and frame grid (ARCHITECTURE rule 7)."
                    },
                    "behavior": {
                        "type": "string",
                        "enum": [
                            "math_challenger",
                            "talker",
                            "shopkeeper",
                            "quest_giver"
                        ]
                    },
                    "components": {
                        "type": "array",
                        "items": {
                            "type": "object",
                            "required": [
                                "type"
                            ],
                            "properties": {
                                "type": {
                                    "type": "string"
                                }
                            },
                            "additionalProperties": true
                        }
                    },
                    "behaviorConfig": {
                        "type": "object",
                        "properties": {
                            "rewardType": {
                                "type": "string"
                            },
                            "rewardAmount": {
                                "type": "integer",
                                "minimum": 0
                            },
                            "chainLinks": {
                                "type": "integer",
                                "minimum": 1,
                                "description": "Chain links binding this owl. Must equal the math_challenge component's problemCount - it is the same number, surfaced for art and HUD."
                            }
                        },
                        "additionalProperties": true
                    },
                    "note": {
                        "type": "string",
                        "description": "Author-facing note on when to use this NPC. Not read at runtime."
                    }
                }
            }
        }
    }
}
