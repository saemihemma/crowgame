{
  "$comment": "Every runtime sprite, by key. What each KIND of sprite must be lives in sprite_spec.json (transcribed from brand/ASSET_MANIFEST.md); this file says only what each individual asset IS. Frame size and anchor come from the class and must not be restated. Tilesets are not here — tileset_manifest.json owns those.",
  "fields": {
    "class": "which class in sprite_spec.json this asset belongs to; supplies frameWidth, frameHeight and anchor",
    "path": "res:// path, written without the res:// prefix",
    "frames": "cells to read, left-to-right then top-to-bottom; 1 = a single still image",
    "fps": "playback speed; ignored when frames == 1",
    "loop": "whether the animation repeats",
    "anim": "SpriteFrames animation name the entity plays",
    "optional": "true for a slot the art has not landed in yet. Missing files are not a build failure for these; the caller falls back. See `fallback`.",
    "fallback": "sprite key to use while an optional slot is empty",
    "frameWidth / frameHeight / anchor": "per-asset override of the class. Requires a `why`.",
    "why": "required beside any override — puts the deviation on the record instead of letting it drift"
  },
