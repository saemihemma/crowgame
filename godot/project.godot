; Engine configuration file.
; Crow — Godot 4 port of the Phaser 3 educational platformer.
; Settings mirror src/main.ts: 960x540 pixel-art, FIT+center, gravity 800.

config_version=5

[application]

config/name="Hörmann"
config/description="Child-first educational 2D pixel-art platformer. Godot 4 port."
run/main_scene="res://scenes/Boot.tscn"
config/features=PackedStringArray("4.3", "GL Compatibility")
config/icon="res://icon.svg"

[autoload]

Persistence="*res://scripts/autoload/persistence.gd"
EventBus="*res://scripts/autoload/event_bus.gd"
DataManager="*res://scripts/autoload/data_manager.gd"
SceneRouter="*res://scripts/autoload/scene_router.gd"
Config="*res://scripts/autoload/config.gd"
ProfileManager="*res://scripts/autoload/profile_manager.gd"
SaveManager="*res://scripts/autoload/save_manager.gd"
TextManager="*res://scripts/autoload/text_manager.gd"
LevelManager="*res://scripts/autoload/level_manager.gd"
LevelingManager="*res://scripts/autoload/leveling_manager.gd"
ThemeManager="*res://scripts/autoload/theme_manager.gd"
AudioManager="*res://scripts/autoload/audio_manager.gd"
ELOManager="*res://scripts/math/elo_manager.gd"
LearnerStateManager="*res://scripts/systems/learner_state_manager.gd"
MathProblemManager="*res://scripts/math/math_problem_manager.gd"
LearnerSyncService="*res://scripts/systems/learner_sync_service.gd"
ELOUpdateManager="*res://scripts/systems/elo_update_manager.gd"
SessionStats="*res://scripts/autoload/session_stats.gd"
TutorialManager="*res://scripts/systems/tutorial_manager.gd"
CloudSync="*res://scripts/systems/cloud_sync.gd"

[display]

window/size/viewport_width=960
window/size/viewport_height=540
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/handheld/orientation=0

[rendering]

textures/canvas_textures/default_texture_filter=0
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
environment/defaults/default_clear_color=Color(0.529412, 0.807843, 0.921569, 1)

[importer_defaults]

; Pixel-art import preset. brand/ASSET_MANIFEST.md states the law for the source
; files ("no anti-aliasing", "author at 1x"); this is the engine half — every PNG
; dropped into assets/ inherits it, so a new sprite is crisp by default instead of
; relying on someone remembering the per-file toggles in the editor.
;   compress/mode=0        lossless — block compression smears pixel art
;   mipmaps/generate=false never rendered below 1:1
;   fix_alpha_border=false an alpha bleed is a bilinear fix; under Nearest it only
;                          rewrites RGB beneath transparent pixels for nothing
;   detect_3d/compress_to=0 never silently switch a 2D sprite to VRAM compression
; Enforced by godot/tools/check_assets.py.
texture={
"compress/mode": 0,
"mipmaps/generate": false,
"process/fix_alpha_border": false,
"detect_3d/compress_to": 0
}

[physics]

2d/default_gravity=800.0

[input_devices]

; OFF, and the on-screen pads are hidden wherever it would have mattered.
;
; This was on because the pads were shown in every web export, desktop included,
; and Godot does not route mouse input to a TouchScreenButton by default. But
; showing a five-button d-pad to someone holding a keyboard was the bug, not the
; unreachable buttons: the owner played on a PC and got a thumb gamepad over the
; level. TouchControls now asks DisplayServer.is_touchscreen_available(), which
; on the web reports what the browser reports, so the pads appear on a tablet
; and never on a desktop.
;
; Those two changes have to land together. This setting is an input of
; is_touchscreen_available() -- with it on, the engine says "yes, touch" on every
; machine, and the honest check would answer the same wrong thing it used to.
; Real touch input is native and needs no emulation, so turning it off costs a
; touch device nothing. Verified in tests/test_touch_controls.gd, which drives a
; real InputEventScreenTouch through to the bound action.
pointing/emulate_touch_from_mouse=false

