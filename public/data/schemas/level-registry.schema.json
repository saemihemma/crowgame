{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "title": "LevelRegistry",
    "description": "Registry of all game levels",
    "type": "object",
    "required": ["levels"],
    "properties": {
        "levels": {
            "type": "array",
            "items": {
                "type": "object",
                "required": ["key", "name", "mapFile", "tilesetImages", "order"],
                "properties": {
                    "key": { "type": "string", "pattern": "^level_\\d+" },
                    "name": { "type": "string", "minLength": 1 },
                    "mapFile": { "type": "string" },
                    "tilesetImages": {
                        "type": "object",
                        "additionalProperties": { "type": "string" }
                    },
                    "music": { "type": "string" },
                    "unlockRequirement": {
                        "oneOf": [
                            { "type": "null" },
                            {
                                "type": "object",
                                "required": ["level", "minStars"],
                                "properties": {
                                    "level": { "type": "string" },
                                    "minStars": { "type": "integer", "minimum": 0 }
                                }
                            }
                        ]
                    },
                    "order": { "type": "integer", "minimum": 1 }
                }
            }
        }
    }
}
