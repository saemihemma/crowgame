# Build and run artifacts. The one exception is output/web, which IS committed:
# it holds the exact bytes that get deployed, and the error-pipeline e2e test
# exercises them. Everything else here is a diagnostic that nothing reads back.
/output/linux/
/output/*.zip
output/web/*.gz
output/web/*.br
output/godot-shots/
output/playwright/
reports/web/

# Python bytecode, left behind whenever the asset guard imports audit_pixel_art.
__pycache__/
*.pyc
