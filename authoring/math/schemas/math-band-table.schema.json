{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "MathBandTable",
  "type": "object",
  "required": ["bands"],
  "properties": {
    "bands": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "domain", "family", "curriculumStepRange", "targetEloRange", "ageBand"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "domain": {
            "type": "string",
            "enum": ["addition", "subtraction", "multiplication", "division", "counting", "comparison", "pattern_matching", "number_sequence"]
          },
          "family": { "type": "string", "minLength": 1 },
          "curriculumStepRange": {
            "type": "array",
            "items": { "type": "integer", "minimum": 0 },
            "minItems": 2,
            "maxItems": 2
          },
          "targetEloRange": {
            "type": "array",
            "items": { "type": "integer", "minimum": 100, "maximum": 1100 },
            "minItems": 2,
            "maxItems": 2
          },
          "ageBand": {
            "type": "array",
            "items": { "type": "integer", "minimum": 3, "maximum": 12 },
            "minItems": 2,
            "maxItems": 2
          },
          "notes": { "type": "string" }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
