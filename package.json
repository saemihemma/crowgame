{
    "name": "crow-platformer",
    "description": "A 2D pixel art educational platformer featuring H\u00f6rmann, a crow protagonist.",
    "version": "0.1.0",
    "private": true,
    "scripts": {
        "dev": "vite --config vite/config.dev.mjs",
        "build": "npm run validate && npm run compile && vite build --config vite/config.prod.mjs",
        "validate": "tsx tools/validate-content.ts && node tools/validate_docs.js && node tools/validate_assets.js && node tools/validate_i18n.mjs",
        "validate:docs": "node tools/validate_docs.js",
        "validate:assets": "node tools/validate_assets.js",
        "compile": "tsx tools/compile-levels.ts",
        "tilesets": "node tools/gen_tilesets.mjs",
        "tilesets:check": "node tools/gen_tilesets.mjs --check",
        "math:materialize": "tsx tools/materialize_math_batches.ts",
        "math:review": "tsx tools/review_math_batches.ts",
        "math:browser-smoke": "node tools/math_browser_smoke.mjs",
        "math:sync-metadata": "tsx tools/sync_math_problem_metadata.ts",
        "godot:gen-math-fixtures": "tsx tools/golden/gen_math_fixtures.ts",
        "godot:gen-motion-fixtures": "tsx tools/golden/gen_motion_fixtures.ts",
        "process:audio": "node tools/process_audio.js",
        "ai:extract": "node tools/process_ai_assets.js --mode extract",
        "ai:process": "node tools/process_ai_assets.js",
        "dev:host": "vite --config vite/config.dev.mjs --host",
        "validate:i18n": "node tools/validate_i18n.mjs",
        "i18n:screenshots": "node tools/i18n_screenshots.mjs",
        "themes:screenshots": "node tools/theme_screenshots.mjs"
    },
    "devDependencies": {
        "ajv": "^8.17.1",
        "ajv-formats": "^3.0.1",
        "chalk": "^5.6.2",
        "cli-progress": "^3.12.0",
        "fast-glob": "^3.3.3",
        "playwright-core": "^1.58.2",
        "pngjs": "^7.0.0",
        "sharp": "^0.34.5",
        "tsx": "^4.21.0",
        "typescript": "~5.7.2",
        "vite": "^6.3.1"
    },
    "dependencies": {
        "phaser": "^3.90.0",
        "terser": "^5.39.0"
    }
}
