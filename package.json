{
    "name": "crow-platformer",
    "description": "Child-first educational math platformer (Godot 4). This package holds the offline math-authoring toolchain and the TS parity kernel, not the game runtime.",
    "version": "0.1.0",
    "private": true,
    "scripts": {
        "ai:extract": "node tools/process_ai_assets.js --mode extract",
        "ai:process": "node tools/process_ai_assets.js",
        "api:migrate": "npm --prefix server run migrate",
        "api:test": "npm --prefix server test",
        "compile": "tsx tools/compile-levels.ts",
        "e2e:errors": "node godot/tools/error_pipeline_e2e.mjs",
        "godot:gen-math-fixtures": "tsx tools/golden/gen_math_fixtures.ts",
        "godot:gen-motion-fixtures": "tsx tools/golden/gen_motion_fixtures.ts",
        "godot:test": "bash godot/tools/run_tests.sh",
        "math:browser-smoke": "node tools/math_browser_smoke.mjs",
        "math:materialize": "tsx tools/materialize_math_batches.ts",
        "math:review": "tsx tools/review_math_batches.ts",
        "math:sync-metadata": "tsx tools/sync_math_problem_metadata.ts",
        "process:audio": "node tools/process_audio.js",
        "typecheck": "tsc --noEmit",
        "validate": "tsx tools/validate-content.ts && node tools/validate_docs.js && node tools/validate_assets.js",
        "validate:assets": "node tools/validate_assets.js",
        "validate:docs": "node tools/validate_docs.js",
        "web:boot-smoke": "node godot/tools/web_boot_smoke.mjs",
        "web:build": "bash godot/tools/build_web.sh"
    },
    "devDependencies": {
        "@types/node": "^22.20.1",
        "ajv": "^8.17.1",
        "ajv-formats": "^3.0.1",
        "chalk": "^5.6.2",
        "cli-progress": "^3.12.0",
        "fast-glob": "^3.3.3",
        "playwright-core": "^1.58.2",
        "sharp": "^0.34.5",
        "tsx": "^4.21.0",
        "typescript": "~5.7.2",
        "vite": "^6.3.1"
    }
}
