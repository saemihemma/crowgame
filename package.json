{
  "name": "crow-platformer",
  "description": "Child-first educational math platformer (Godot 4). This package holds the offline math-authoring toolchain and the TS parity kernel, not the game runtime.",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "ai:extract": "node tools/process_ai_assets.js --mode extract",
    "ai:process": "node tools/process_ai_assets.js",
    "api:migrate": "npm --prefix server run migrate",
    "api:test": "npm --prefix server test",
    "api:verify-restore": "npm --prefix server run verify:restore",
    "audio:audit": "node tools/run_python.mjs tools/audit_audio.py",
    "audio:gen": "node tools/gen_audio_elevenlabs.mjs",
    "audio:sfx": "node tools/run_python.mjs tools/gen_sfx.py",
    "cms": "node tools/cms/server.mjs",
    "compile": "tsx tools/compile-levels.ts",
    "e2e:errors": "node godot/tools/error_pipeline_e2e.mjs",
    "godot:gen-math-fixtures": "tsx tools/golden/gen_math_fixtures.ts",
    "godot:gen-motion-fixtures": "tsx tools/golden/gen_motion_fixtures.ts",
    "godot:test": "bash godot/tools/run_tests.sh",
    "math:journey": "tsx tools/sim_learner_journey.ts --trace",
    "math:ladder-weights": "tsx tools/gen_ladder_weights.ts",
    "math:materialize": "tsx tools/materialize_math_batches.ts && npm run math:phrasing",
    "math:phrasing": "node tools/fix_math_plural_grammar.mjs && node tools/derive_math_phrasing.mjs --write && node tools/sync_math_phrasing_bundles.mjs",
    "math:review": "tsx tools/review_math_batches.ts",
    "math:step-domains": "tsx tools/gen_step_domains.ts",
    "math:stress": "node tools/validate_icelandic_pedagogy.mjs && node tools/stress_test_math_is.mjs",
    "math:sync-metadata": "tsx tools/sync_math_problem_metadata.ts",
    "process:audio": "node tools/process_audio.js",
    "typecheck": "tsc --noEmit",
    "validate": "tsx tools/validate-content.ts && node tools/validate_docs.js && node tools/validate_assets.js && node tools/validate_i18n.mjs && node tools/validate_icelandic_pedagogy.mjs && node tools/validate_math_concepts.mjs && tsx tools/validate_lesson_bands.ts && tsx tools/sim_learner_journey.ts && node tools/validate_export.mjs && python3 tools/verify_palettes.py",
    "validate:assets": "node tools/validate_assets.js",
    "validate:concepts": "node tools/validate_math_concepts.mjs",
    "validate:docs": "node tools/validate_docs.js",
    "validate:docs-test": "bash tools/test_validate_docs.sh",
    "validate:i18n": "node tools/validate_i18n.mjs",
    "validate:lesson-bands": "tsx tools/validate_lesson_bands.ts",
    "validate:pedagogy": "node tools/validate_icelandic_pedagogy.mjs",
    "web:boot-smoke": "node godot/tools/web_boot_smoke.mjs",
    "web:build": "bash godot/tools/build_web.sh"
  },
  "devDependencies": {
    "@types/node": "^22.20.1",
    "ajv": "^8.17.1",
    "ajv-formats": "^3.0.1",
    "fast-glob": "^3.3.3",
    "playwright-core": "^1.58.2",
    "sharp": "^0.34.5",
    "tsx": "^4.21.0",
    "typescript": "~5.7.2"
  }
}
